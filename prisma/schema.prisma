// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
    provider      = "prisma-client-js"
    output        = "../generated/prisma"
    binaryTargets = ["native", "darwin", "windows", "rhel-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
    id            String    @id @default(cuid())
    clerkId       String    @unique
    email         String    @unique
    firstName     String?
    lastName      String?
    imageUrl      String?
    createdAt     DateTime  @default(now())
    updatedAt     DateTime  @updatedAt
    
    // Relations
    accounts      EmailAccount[]
    
    @@map("users")
}

model EmailAccount {
    id                String    @id @default(cuid())
    userId            String
    orengoAccountId   String    @unique
    email             String
    name              String?
    provider          String    // gmail, outlook, etc.
    accessToken       String?
    refreshToken      String?
    tokenExpiresAt    DateTime?
    isActive          Boolean   @default(true)
    lastSyncAt        DateTime?
    deltaToken        String?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    
    // Relations
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    threads           Thread[]
    emails            Email[]
    
    @@map("email_accounts")
}

model Thread {
    id                String    @id @default(cuid())
    accountId         String
    orengoThreadId    String
    subject           String?
    snippet           String?
    isRead            Boolean   @default(false)
    isImportant       Boolean   @default(false)
    isStarred         Boolean   @default(false)
    isArchived        Boolean   @default(false)
    isDeleted         Boolean   @default(false)
    lastMessageAt     DateTime?
    participantCount  Int       @default(0)
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    
    // Relations
    account           EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    emails            Email[]
    
    @@unique([accountId, orengoThreadId])
    @@map("threads")
}

model Email {
    id                String    @id @default(cuid())
    accountId         String
    threadId          String?
    orengoMessageId   String    @unique
    subject           String?
    body              String?
    bodySnippet       String?
    isRead            Boolean   @default(false)
    isImportant       Boolean   @default(false)
    isStarred         Boolean   @default(false)
    isDraft           Boolean   @default(false)
    isSent            Boolean   @default(false)
    isArchived        Boolean   @default(false)
    isDeleted         Boolean   @default(false)
    sentAt            DateTime?
    receivedAt        DateTime?
    scheduledAt       DateTime?
    archivedAt        DateTime?
    deletedAt         DateTime?
    createdAt         DateTime  @default(now())
    updatedAt         DateTime  @updatedAt
    
    // Relations
    account           EmailAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
    thread            Thread?   @relation(fields: [threadId], references: [id], onDelete: SetNull)
    addresses         EmailAddress[]
    attachments       EmailAttachment[]
    
    @@map("emails")
}

model EmailAddress {
    id        String    @id @default(cuid())
    emailId   String
    type      String    // from, to, cc, bcc, reply-to
    name      String?
    address   String
    createdAt DateTime  @default(now())
    
    // Relations
    email     Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
    
    @@map("email_addresses")
}

model EmailAttachment {
    id          String    @id @default(cuid())
    emailId     String
    filename    String
    mimeType    String?
    size        Int?
    contentId   String?
    url         String?
    createdAt   DateTime  @default(now())
    
    // Relations
    email       Email     @relation(fields: [emailId], references: [id], onDelete: Cascade)
    
    @@map("email_attachments")
}

model ChatInteraction {
    id        String    @id @default(cuid())
    userId    String
    message   String
    response  String?
    createdAt DateTime  @default(now())
    
    @@map("chat_interactions")
}
